+#if TARGET_OS_IOS
+API_AVAILABLE(ios(13.0))
+@interface RetroArchSceneDelegate : NSObject <UIWindowSceneDelegate>
+@property (nonatomic, strong) UIWindow *window;
+@end
+
+@implementation RetroArchSceneDelegate
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session
+      options:(UISceneConnectionOptions *)connectionOptions
+{
+   if (![scene isKindOfClass:[UIWindowScene class]])
+      return;
+
+   RetroArch_iOS *app = [RetroArch_iOS get];
+   if (app.window)
+   {
+      /* Reconnect the existing frontend rather than initializing it twice. */
+      self.window = app.window;
+      self.window.windowScene = (UIWindowScene *)scene;
+      [self.window makeKeyAndVisible];
+   }
+   else
+   {
+      self.window = [[UIWindow alloc] initWithWindowScene:(UIWindowScene *)scene];
+      [app startWithWindow:self.window];
+   }
+   [self scene:scene openURLContexts:connectionOptions.URLContexts];
+}
+
+- (void)sceneDidBecomeActive:(UIScene *)scene
+{
+   [[RetroArch_iOS get] applicationDidBecomeActive:[UIApplication sharedApplication]];
+}
+
+- (void)sceneWillResignActive:(UIScene *)scene
+{
+   [[RetroArch_iOS get] applicationWillResignActive:[UIApplication sharedApplication]];
+}
+
+- (void)sceneDidEnterBackground:(UIScene *)scene
+{
+   [[RetroArch_iOS get] applicationDidEnterBackground:[UIApplication sharedApplication]];
+}
+
+- (void)scene:(UIScene *)scene openURLContexts:(NSSet<UIOpenURLContext *> *)URLContexts
+{
+   for (UIOpenURLContext *context in URLContexts)
+   {
+      NSMutableDictionary *options = [NSMutableDictionary dictionary];
+      if (context.options.sourceApplication)
+         options[UIApplicationOpenURLOptionsSourceApplicationKey] = context.options.sourceApplication;
+      if (context.options.annotation)
+         options[UIApplicationOpenURLOptionsAnnotationKey] = context.options.annotation;
+      options[UIApplicationOpenURLOptionsOpenInPlaceKey] = @(context.options.openInPlace);
+      [[RetroArch_iOS get] application:[UIApplication sharedApplication]
+                              openURL:context.URL options:options];
+   }
+}
+
+@end
+#endif
+
