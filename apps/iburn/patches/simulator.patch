@@ -0,0 +1,39 @@
+// Simulator lifecycle adaptation, 2026-11-22.
+// Based on https://github.com/iBurnApp/iBurn-iOS/pull/254.
+#import "BRCSceneDelegate.h"
+#import "BRCAppDelegate.h"
+
+@implementation BRCSceneDelegate
+- (void)scene:(UIScene *)scene
+    willConnectToSession:(UISceneSession *)session
+                 options:(UISceneConnectionOptions *)connectionOptions {
+  if (![scene isKindOfClass:UIWindowScene.class]) {
+    return;
+  }
+  BRCAppDelegate *delegate = BRCAppDelegate.shared;
+  [delegate setupWindowForScene:(UIWindowScene *)scene];
+  self.window = delegate.window;
+  for (UIOpenURLContext *context in connectionOptions.URLContexts) {
+    [delegate handleIncomingURL:context.URL];
+  }
+  for (NSUserActivity *activity in connectionOptions.userActivities) {
+    [self scene:scene continueUserActivity:activity];
+  }
+}
+
+- (void)scene:(UIScene *)scene
+    openURLContexts:(NSSet<UIOpenURLContext *> *)URLContexts {
+  for (UIOpenURLContext *context in URLContexts) {
+    [BRCAppDelegate.shared handleIncomingURL:context.URL];
+  }
+}
+
+- (void)scene:(UIScene *)scene
+    continueUserActivity:(NSUserActivity *)userActivity {
+  if ([userActivity.activityType
+          isEqualToString:NSUserActivityTypeBrowsingWeb] &&
+      userActivity.webpageURL) {
+    [BRCAppDelegate.shared handleIncomingURL:userActivity.webpageURL];
+  }
+}
+@end
