 SCHEME="Systems"
-PLATFORM="iOS"
+PLATFORM="iOS Simulator"
 
-BUILD_DIR=".build"
+BUILD_DIR="$DELTA_SYSTEMS_DERIVED_DATA"
 
 case $PLATFORM in
 "iOS")
@@ -19,6 +19,16 @@ esac
 
 OUTPUT_DIR="$BUILD_DIR/Build/Products/$CONFIG_FOLDER"
 
-xcodebuild -workspace Systems.xcworkspace -scheme $SCHEME -configuration ${CONFIGURATION} -destination "generic/platform=$PLATFORM" -derivedDataPath $BUILD_DIR BITCODE_GENERATION_MODE=bitcode
+xcodebuild -workspace Systems.xcworkspace -scheme "$SCHEME" -configuration "$CONFIGURATION" \
+    -sdk iphonesimulator -destination "generic/platform=$PLATFORM" -derivedDataPath "$BUILD_DIR" \
+    -clonedSourcePackagesDirPath "$DELTA_SYSTEMS_PACKAGES" -packageCachePath "$DELTA_PACKAGE_CACHE" \
+    -disableAutomaticPackageResolution -onlyUsePackageVersionsFromResolvedFile -jobs 2 \
+    ARCHS=arm64 ONLY_ACTIVE_ARCH=YES IPHONEOS_DEPLOYMENT_TARGET="$IPHONEOS_DEPLOYMENT_TARGET" \
