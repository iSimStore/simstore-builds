+
+# Re-exported Swift modules must also be visible to the parent app's dependency scanner.
+for module in GPGXDeltaCore GPGXSwift; do
+    cp -Rf "$OUTPUT_DIR/$module.swiftmodule" "${BUILT_PRODUCTS_DIR}/"
+done
