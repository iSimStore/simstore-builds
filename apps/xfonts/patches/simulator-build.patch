--- a/xFonts/AppDelegate.m
+++ b/xFonts/AppDelegate.m
@@ -19 +19,22 @@ - (BOOL)application:(UIApplication *)application didFinishLaunchingWithOptions:(
 @end
+
+// Simulator recipe: attach the original storyboard to a window scene.
+@interface FontcaseSceneDelegate : UIResponder <UIWindowSceneDelegate>
+@property (strong, nonatomic) UIWindow *window;
+@end
+
+@implementation FontcaseSceneDelegate
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)connectionOptions
+{
+    if (![scene isKindOfClass:UIWindowScene.class]) {
+        return;
+    }
+    self.window = [[UIWindow alloc] initWithWindowScene:(UIWindowScene *)scene];
+    self.window.rootViewController = [[UIStoryboard storyboardWithName:@"Main" bundle:nil] instantiateInitialViewController];
+    AppDelegate *delegate = (AppDelegate *)UIApplication.sharedApplication.delegate;
+    delegate.window = self.window;
+    [self.window makeKeyAndVisible];
+}
+
+@end
