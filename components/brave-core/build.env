channel=release
target_os=ios
target_arch=arm64
target_environment=simulator
use_remoteexec=false
use_brave_hermetic_toolchain=false
ignore_patch_version_number=false
brave_extra_gn_gen_opts=--root-target=//brave/ios
gclient_global_vars={"target_os_only":true}
projects_chrome_custom_vars_checkout_clangd=false
projects_chrome_custom_vars_checkout_clang_coverage_tools=false
projects_chrome_custom_vars_checkout_configuration=small
gn_args={"is_official_build":false,"ios_enable_code_signing":false,"symbol_level":0,"chrome_pgo_phase":0,"action_pool_depth":1,"concurrent_links":1}
